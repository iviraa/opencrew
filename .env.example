# planner database: local docker (docker compose up -d) or the Supabase copy (planner schema)
DATABASE_URL=postgresql://postgres:opencrew@localhost:5433/opencrew_national
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# on supabase the planner tables live in their own schema
# DB_SEARCH_PATH=planner, extensions, public
# logins, requests, notifications, chat memory
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
GOOGLE_PLACES_KEY=
DEMO_INBOX_UTILITY=
DEMO_INBOX_VENDOR=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

